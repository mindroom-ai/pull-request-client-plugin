{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": [],
    "baseUrl": ".",
    "paths": {
      "@mindroom/client-sdk/*": ["./.mindroom-chat/src/client-sdk/*"],
      "react": ["./.mindroom-chat/node_modules/@types/react"],
      "react/*": ["./.mindroom-chat/node_modules/@types/react/*"],
      "react-dom": ["./.mindroom-chat/node_modules/@types/react-dom"],
      "react-dom/*": ["./.mindroom-chat/node_modules/@types/react-dom/*"],
      "focus-trap-react": ["./.mindroom-chat/node_modules/focus-trap-react"],
      "folds": ["./.mindroom-chat/node_modules/folds"],
      "@tanstack/*": ["./.mindroom-chat/node_modules/@tanstack/*"],
      "react-i18next": ["./.mindroom-chat/node_modules/react-i18next"],
      "vitest": ["./.mindroom-chat/node_modules/vitest"]
    }
  },
  "include": ["src", ".mindroom-chat/src/types"]
}
